---
const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
const isCurrent = (path) => pathname.startsWith(`${base}${path}`);
---

<header class="site-header">
  <a class="site-header__brand" href={base} aria-label="Portfolio トップページ">Portfolio</a>
  <nav aria-label="メインナビゲーション">
    <ul class="site-header__nav">
      <li><a href={`${base}works/`} aria-current={isCurrent("works/") ? "page" : undefined}>Works</a></li>
      <li><a href={`${base}about/`} aria-current={isCurrent("about/") ? "page" : undefined}>About</a></li>
      <li><a href={`${base}contact/`} aria-current={isCurrent("contact/") ? "page" : undefined}>Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-block-size: 4.5rem;
  }

  .site-header__brand {
    color: var(--color-text);
    font-size: var(--font-size-label);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    text-decoration-color: transparent;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current="page"] {
    color: var(--color-text);
    text-decoration-color: currentColor;
  }

  @media (min-width: 48rem) {
    .site-header__nav {
      gap: var(--space-8);
    }
  }
</style>
